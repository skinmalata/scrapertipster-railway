# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Gemini API (for AI analysis)
GEMINI_API_KEY=your-gemini-api-key

# Mastodon/Fediverse Auto-Posting
MASTODON_INSTANCE_URL=https://flipboard.social
MASTODON_ACCESS_TOKEN=your-access-token
MASTODON_AUTO_POST=true

# App Configuration
BASE_URL=https://winfulltime.com
PORT=3002

# API-Football (server-side only; do not expose this value in browser code)
API_FOOTBALL_KEY=your_api_football_key

# Telegram Bot (auto-post in-play tips to channel)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=-1001234567890

# In-play tip history (set this to a path on the deployment's persistent disk)
# LIVE_TIP_HISTORY_FILE=/data/live-tip-history.json

# Active payment provider: 'lemonsqueezy' (default) or 'whop'
# PAYMENT_PROVIDER=whop

# Whop (parallel payment provider for A/B testing alongside Lemon Squeezy)
# WHOP_API_KEY=your-whop-company-api-key
# WHOP_COMPANY_ID=biz_xxxxxxxxxxxxx
# WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
# WHOP_PRODUCT_MONTHLY=prod_xxxxxxxxxxxxx
# WHOP_PRODUCT_YEARLY=prod_xxxxxxxxxxxxx
# WHOP_PRODUCT_LIFETIME=prod_xxxxxxxxxxxxx
