# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Gemini API (for AI analysis)
GEMINI_API_KEY=your-gemini-api-key

# Mastodon/Fediverse Auto-Posting
MASTODON_INSTANCE_URL=https://flipboard.social
MASTODON_ACCESS_TOKEN=your-access-token
MASTODON_AUTO_POST=true

# App Configuration
BASE_URL=https://winfulltime.com
PORT=3002

# API-Football (server-side only; do not expose this value in browser code)
API_FOOTBALL_KEY=your_api_football_key

# Telegram Bot (auto-post in-play tips to channel)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=-1001234567890

# In-play tip history (set this to a path on the deployment's persistent disk)
# LIVE_TIP_HISTORY_FILE=/data/live-tip-history.json

# Brevo daily-ticket newsletter (server-side only; never add the API key to browser code)
BREVO_API_KEY=your-brevo-api-key
BREVO_DAILY_TIPS_LIST_ID=123
BREVO_SENDER_EMAIL=tips@your-domain.com
BREVO_SENDER_NAME=WinFulltime
CRON_SECRET=replace-with-a-long-random-secret
# Use a persistent disk path in production so a restart cannot resend today's campaign.
# DAILY_TIPS_SEND_LOG_FILE=/var/data/daily-tips-send-log.json
