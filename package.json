{
  "name": "football-predictions",
  "version": "1.0.0",
  "description": "Football prediction website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --watch",
    "generate-pins": "node scripts/generate-daily-pins.js",
    "post-pins": "node scripts/post-to-pinterest.js",
    "generate:thumbnail": "node scripts/generate-thumbnail.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@tailwindcss/postcss": "^4.2.2",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7"
  }
}
